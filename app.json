{
  "expo": {
    "name": "LastMinute",
    "slug": "lastminute",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mydadc.lastminute",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.mydadc.lastminute",
      "adaptiveIcon": {
        "backgroundColor": "#0B0B10",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "LastMinute показує твоє фото лише учасникам тієї ж події та в альбомі події.",
          "cameraPermission": "Камера потрібна, щоб додати фото в альбом події."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-logo-light.png",
          "imageWidth": 235,
          "backgroundColor": "#F6F5F1",
          "dark": {
            "image": "./assets/splash-logo-dark.png",
            "backgroundColor": "#0B0B10"
          }
        }
      ]
    ],
    "scheme": "lastminute",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "52cbaaab-c174-41c2-9a68-037e717ee3a8"
      }
    },
    "owner": "myd-adc"
  }
}
